# argentgob-mesh-mvp/.env.example
# Copiar como .env y NO comitear .env

# ── Configuración del LLM ──────────────────────────────────────────
# Sobreescrito por compose.yaml al usar el stack completo
OPENAI_API_BASE=http://localhost:8080/v1
OPENAI_API_KEY=local-no-key-required
OPENAI_MODEL_NAME=llama-3.1-8b-instruct

# ── Base de datos ──────────────────────────────────────────────────
# NUNCA comitear la contraseña real
DATABASE_URL=postgresql+psycopg://argentgob_app:CHANGE_ME@localhost:5432/argentgob
POSTGRES_PASSWORD=CHANGE_ME

# ── Gobernanza ─────────────────────────────────────────────────────
ENVIRONMENT=LOCAL
LOG_LEVEL=INFO
AGENT_PROFILE=analyst

# ── Límites de payload ─────────────────────────────────────────────
MAX_PAYLOAD_BYTES=65536
MAX_JSON_DEPTH=16
MAX_JSON_NODES=1000
MAX_STRING_BYTES=4096
PRIVACY_SCAN_TIMEOUT_MS=25
RATE_LIMIT_CALLS_PER_RUN=5

# --- AV-02: secretos por consumidor (archivos, nunca valores en compose) ---
# El inicializador habilita LOGIN de los roles de runtime con estos archivos.
# Crear con `make setup`; no comitear.
# ARGENTGOB_RUNTIME_PASSWORD_FILE=/run/secrets/runtime_password
# ARGENTGOB_DASHBOARD_PASSWORD_FILE=/run/secrets/dashboard_password
# ARGENTGOB_ADMIN_PASSWORD_FILE=/run/secrets/postgres_password
# AGENT_API_SERVICE_TOKEN_FILE=/run/secrets/service_token

# --- AV-02: identidad HITL del despliegue (fixture solo LOCAL/TEST) ---
IDENTITY_DEVELOPMENT_ONLY=true
IDENTITY_FIXTURE_ROLES={"auditor-1": ["viewer", "auditor"]}
AUTHORIZED_AUDITOR_ROLES=["auditor"]

# --- AV-02: artefactos del predictor (RO) ---
RISK_MODEL_DIR=/app/data/models/risk_model_v1
RISK_CORPUS_PATH=/app/data/corpus/corpus_v1.parquet

# --- AV-02: API interna de runs ---
AGENT_API_HOST=0.0.0.0
AGENT_API_PORT=8090
AGENT_API_BASE=http://agent:8090
